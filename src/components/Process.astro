---
// src/components/Process.astro

interface ProcessStep {
  index: number;
  id: string;
  themeClass: string;
  title: string;
  subtitle: string;
  image: string;
  alt: string;
  description: string;
}

const steps: ProcessStep[] = [
  {
    index: 1,
    id: 'process-card-1',
    themeClass: 'process-card--one',
    title: '01. Understand',
    subtitle: 'Audience Intelligence & Creative Discovery',
    image: '/Assets/projects/method-audit.jpg',
    alt: 'Understand — Blank creative strategy notebook and drafting tools for audience intelligence',
    description: 'Before a single frame is shot, we dissect audience psychology, algorithmic feed dynamics, and market voids. We identify what stops your ideal customer mid-scroll, map out content hooks that provoke visceral engagement, and architect an organic strategy rooted in authentic brand conviction rather than fleeting trends.'
  },
  {
    index: 2,
    id: 'process-card-2',
    themeClass: 'process-card--two',
    title: '02. Sharpen',
    subtitle: 'Cinema-Grade Production & Viral Scripting',
    image: '/Assets/projects/method-position.jpg',
    alt: 'Sharpen — Precision cinema lenses and optics calibrated for high-end video production',
    description: 'We translate strategic insights into magnetic visual storytelling. From cinema-grade camera optics and intentional lighting to high-retention scripting, rapid-fire pacing, and bespoke sound design: every cut is calibrated to seize the feed, sustain view time, and turn casual scrollers into an obsessed community.'
  },
  {
    index: 3,
    id: 'process-card-3',
    themeClass: 'process-card--three',
    title: '03. Dominate',
    subtitle: 'Immersive Web Flagships & Pipeline Conversion',
    image: '/Assets/projects/method-dominate.jpg',
    alt: 'Dominate — Minimalist keyboard layout engineered for bespoke immersive web experiences',
    description: 'Attention without infrastructure is wasted momentum. We complete the pipeline by channeling viral video demand directly into bespoke digital flagships. Lightning-fast architecture, editorial typography, and seamless conversion UX ensure every captured viewer lands in an immersive world built to turn attention into revenue.'
  }
];
---

<!-- Section 6: 3-Step Process (Editorial Sticky Stacking Cards) -->
<section class="process section-border" id="process" aria-label="Our Method">
  <div class="container">
    <div class="process__header reveal">
      <h2 class="t-heading-1">
        Building digital authority<br />is an exact science.
      </h2>
      <p class="process__subhead">
        Scroll to experience our complete creative pipeline: from audience immersion to full-scale digital domination.
      </p>
    </div>

    <!-- Diagonal statement tape above the method cards -->
    <div class="method-tape" aria-hidden="true">
      <div class="method-tape__track">
        <span>OUR 3-STEP METHOD ·</span>
        <span>OUR 3-STEP METHOD ·</span>
        <span>OUR 3-STEP METHOD ·</span>
        <span>OUR 3-STEP METHOD ·</span>
        <span>OUR 3-STEP METHOD ·</span>
        <span>OUR 3-STEP METHOD ·</span>
      </div>
    </div>

    <div class="process__stack" id="process-stack" itemscope itemtype="https://schema.org/HowTo">
      <meta itemprop="name" content="Renvel Studio's 3-step growth method" />
      {steps.map((step) => (
        <article
          class={`process-card ${step.themeClass}`}
          id={step.id}
          data-index={step.index}
          itemprop="step"
          itemscope
          itemtype="https://schema.org/HowToStep"
        >
          <meta itemprop="position" content={String(step.index)} />

          <!-- Text layer: hidden at rest, GSAP fades it in as the media shrinks into its slot -->
          <div class="process-card__text-layer">
            <div class="process-card__header">
              <div class="process-card__title-group">
                <h3 class="process-card__title" itemprop="name">{step.title}</h3>
                <span class="process-card__subtitle">{step.subtitle}</span>
              </div>
            </div>

            <!-- Invisible placeholder reserving the media's final layout position/size -->
            <div class="process-card__media-slot" aria-hidden="true"></div>

            <div class="process-card__body">
              <p class="process-card__text" itemprop="text">{step.description}</p>
            </div>
          </div>

          <!-- Actual media: absolutely positioned, GSAP animates it from full-card-cover
               down to the media-slot's position/size as the user scrolls through this card -->
          <div class="process-card__media">
            <img src={step.image} alt={step.alt} loading="lazy" decoding="async" itemprop="image" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>