---
// src/components/Navbar.astro
---

<!-- Section: Navigation Header -->
<header class="nav" id="nav" role="banner">
  <div class="nav__brand">
    <a href="#hero" class="nav__logo" aria-label="Renvel Studio Home">
      <svg class="nav__logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <polygon points="16,3 29,27 3,27" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
        <circle cx="16" cy="19" r="4.5" fill="currentColor" />
        <circle cx="16" cy="19" r="1.8" fill="#0a0a0c" />
      </svg>
      <span class="nav__logo-text">Renvel Studio</span>
    </a>
  </div>

  <div class="nav__right">
    <button class="nav__burger" id="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
      <span class="nav__burger-line"></span>
      <span class="nav__burger-line"></span>
    </button>
  </div>
</header>
