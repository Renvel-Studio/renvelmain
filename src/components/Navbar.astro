---
// src/components/Navbar.astro
---

<!-- Section: Navigation Header -->
<header class="nav" id="nav" role="banner">
  <div class="nav__brand">
    <a href="#hero" class="nav__logo" aria-label="Renvel Studio Home">
      <img
        src="/Assets/renvel-assets/renvel-logo.png"
        alt="Renvel Studio"
        class="nav__logo-img"
        height="26"
        loading="eager"
        decoding="async"
      />
    </a>
  </div>

  <div class="nav__right">
    <button
      class="nav__menu-btn nav__burger"
      id="nav-burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="nav__menu-roller" aria-hidden="true">
        <span class="nav__menu-track nav__menu-track--closed">
          <span class="nav__menu-text">Menu</span>
          <span class="nav__menu-text">Open</span>
        </span>
        <span class="nav__menu-track nav__menu-track--open">
          <span class="nav__menu-text">Close</span>
          <span class="nav__menu-text">Close</span>
        </span>
      </span>
    </button>
  </div>
</header>
