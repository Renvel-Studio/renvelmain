---
// src/components/Stats.astro

interface Stat {
  id: string;
  number: string;
  targetValue: number;
  prefix?: string;
  suffix?: string;
  decimals?: number;
  label: string;
  description: string;
  delayClass?: string;
}

const stats: Stat[] = [
  {
    id: 'stat-impressions',
    number: '20M+',
    targetValue: 20,
    prefix: '',
    suffix: 'M+',
    decimals: 0,
    label: 'Total Organic Views',
    description: 'Over 20 million high-retention video views generated across TikTok and Reels for our portfolio of 5 client brands.'
  },
  {
    id: 'stat-growth',
    number: '+240%',
    targetValue: 240,
    prefix: '+',
    suffix: '%',
    decimals: 0,
    label: 'TikTok & Reels Growth',
    description: 'Algorithmic content strategy, viral hook scripting, and high-retention editing scaling followers across TikTok and Reels.',
    delayClass: 'reveal-delay-1'
  },
  {
    id: 'stat-conversion',
    number: '2.8x',
    targetValue: 2.8,
    prefix: '',
    suffix: 'x',
    decimals: 1,
    label: 'Inbound Conversion Multiplier',
    description: 'High-converting web design and conversion rate optimization (CRO) turning organic traffic into clients with zero ad spend.',
    delayClass: 'reveal-delay-2'
  }
];
---

<!-- Section: Proven Impact Metrics (Immediately below Hero) -->
<section class="stats-section section-border" id="metrics" aria-label="Proven agency impact metrics">
  <div class="stats-section__grid">
    {stats.map((stat) => (
      <div class={`stat reveal ${stat.delayClass || ''}`} id={stat.id}>
        <span
          class="stat__number"
          data-stat-target={stat.targetValue}
          data-stat-prefix={stat.prefix || ''}
          data-stat-suffix={stat.suffix || ''}
          data-stat-decimals={stat.decimals || 0}
        >
          {stat.number}
        </span>
        <span class="stat__label">{stat.label}</span>
        <span class="stat__description">{stat.description}</span>
      </div>
    ))}
  </div>
</section>