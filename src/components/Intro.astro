---
// src/components/Intro.astro
---

<!-- Section 3: Intro Manifesto Statement -->
<section class="intro section-border" id="philosophy" aria-label="Intro Statement & Philosophy">
  <div class="container">
    <h2 class="intro__headline">
      <span class="intro__headline-line intro__headline-line--1">Where conviction meets strategy,</span>
      <span class="intro__headline-line intro__headline-line--2 text-gradient-alt">digital growth is born.</span>
    </h2>

    <!-- Asymmetrical Two-Column Editorial Layout -->
    <div class="intro__editorial-grid">
      <!-- Column Left: Image on Top (dominant, tall crop), Text on Bottom -->
      <div class="intro__col intro__col--left">
        <!-- Left Top: Media Card (Clean, Pure Image, No Words) -->
        <div class="intro__media-card intro__media-card--tilt reveal reveal-delay-1">
          <div class="intro__media-viewport intro__media-viewport--tall">
            <img
              src="/Assets/intro/intro-left.jpg"
              alt="Monolithic architectural studio environment with subtle lighting"
              class="intro__image"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <!-- Left Bottom: Text Card (Smooth Scroll Animated) -->
        <div class="intro__text-card" data-intro-text>
          <span class="intro__tag t-mono intro__anim-item">[ 02 — THE EXECUTION ]</span>
          <h3 class="intro__subheading intro__anim-item">
            Built for businesses ready to lead while others merely follow.
          </h3>
          <div class="intro__text-body">
            <p class="t-body intro__anim-item">
              At Renvel Studio, we build digital presence with substance and style. Driven by search intelligence. Defined by design conviction.
            </p>
            <p class="t-body intro__anim-item">
              From full-scale SEO overhauls to high-converting Next.js websites and viral social media campaigns: we craft positionings that don't just look pretty — they perform. High-impact. Long-term. Intentionally edgy.
            </p>
          </div>
        </div>
      </div>

      <!-- Column Right: Text on Top, Image on Bottom (smaller, offset lower) -->
      <div class="intro__col intro__col--right">
        <!-- Right Top: Text Card (Smooth Scroll Animated) -->
        <div class="intro__text-card" data-intro-text>
          <span class="intro__tag t-mono intro__anim-item">[ 01 — THE CONVICTION ]</span>
          <h3 class="intro__subheading intro__anim-item">
            Brands aren't just logos. They're decisions. Instincts. Digital footprints.
          </h3>
          <div class="intro__text-body">
            <p class="t-body-lg intro__lead-text intro__anim-item">
              Many lose their edge — sounding like everyone, looking like many, and converting no one.
            </p>
            <p class="t-body intro__anim-item">
              Social, SEO, Digital Flagships. Anything but ordinary. We don't chase vanity metrics; we build digital legacies. Because impact beats simple visibility every single time.
            </p>
          </div>
        </div>

        <!-- Right Bottom: Media Card (Clean, Pure Image, No Words) -->
        <div class="intro__media-card intro__media-card--tilt reveal reveal-delay-2">
          <div class="intro__media-viewport">
            <img
              src="/Assets/intro/intro-right.jpg"
              alt="Prismatic chrome geometric sculpture reflections"
              class="intro__image"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Full-Width Panoramic Showcase Below (Clean, Pure Image, No Words) -->
    <div class="intro__panoramic-card reveal reveal-delay-3">
      <div class="intro__media-viewport intro__media-viewport--pano">
        <img
          src="/Assets/intro/intro-panoramic.jpg"
          alt="Cinematic wide-angle digital flagship installation and agency showroom"
          class="intro__image intro__image--pano"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>