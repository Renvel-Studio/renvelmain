---
---

<section class="newsletter-section" id="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter-card">
    <div class="newsletter-card__left">
      <div class="newsletter-card__kicker">
        <span class="newsletter-card__kicker-dot" aria-hidden="true"></span>
        <span>Intelligence Dispatch</span>
      </div>
      <h2 id="newsletter-title" class="newsletter-card__title">
        Private Growth Insights For Select Partners.
      </h2>
      <p class="newsletter-card__desc">
        Direct, unfiltered teardowns of high-performing creative pipelines, algorithmic shifts, and conversion infrastructure. Dispatched bi-weekly.
      </p>
    </div>

    <div class="newsletter-card__right">
      <form id="newsletter-form" class="newsletter-card__form" novalidate>
        <div class="newsletter-card__form-group">
          <label for="newsletter-email" class="sr-only">Business Email</label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            class="newsletter-card__input"
            placeholder="Enter your business email"
            autocomplete="email"
            required
          />

          <button
            type="submit"
            class="newsletter-card__btn"
            aria-label="Get Strategy Access"
          >
            <span class="newsletter-card__btn-track">
              <span class="newsletter-card__btn-slider">
                <span class="newsletter-card__btn-text">Get Strategy Access</span>
                <span class="newsletter-card__btn-text newsletter-card__btn-text--sub">Get Strategy Access</span>
              </span>
            </span>
          </button>
        </div>

        <div id="newsletter-success" class="newsletter-card__success" role="status" aria-live="polite"></div>
        <span class="newsletter-card__disclaimer">Strictly confidential. No spam, zero agency fluff.</span>
      </form>
    </div>
  </div>
</section>