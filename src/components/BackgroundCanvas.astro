---
// src/components/BackgroundCanvas.astro
---

<!-- Living Dynamic Canvas: Ambient Light Engine -->
<div class="ambient-canvas" aria-hidden="true">
  <!-- Primary Moving Radiant Flame & Peach Fluid Orb — sits behind the hero headline -->
  <div class="ambient-orb ambient-orb--yellow-hero"></div>

  <!-- Atmospheric Emerald Ambient Glow — subtle depth & vitality note -->
  <div class="ambient-orb ambient-orb--emerald"></div>

  <!-- Interactive Flame Cursor Luminescence (Follows Pointer Smoothly) -->
  <div class="ambient-orb ambient-orb--interactive" id="ambient-interactive-orb"></div>

  <!-- Cinema-Grade Tactile Film Grain Overlay -->
  <div class="grain-overlay"></div>
</div>

<style>
  .ambient-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    background: var(--bg-0);
  }

  /* Base Fluid Orb Properties */
  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    will-change: transform, border-radius, opacity;
    pointer-events: none;
  }

  /* 1. Primary Moving Flame & Peach Fluid Orb — Center/Hero Focus.
     Single soft blob, kept subtle at the core so text sitting on top
     of it stays crisp; the glow reads at the edges instead. */
  .ambient-orb--yellow-hero {
    top: -10vh;
    left: 20vw;
    width: 65vw;
    height: 65vw;
    max-width: 950px;
    max-height: 950px;
    background: radial-gradient(
      circle at 45% 45%,
      rgba(255, 115, 59, 0.28) 0%,
      rgba(240, 171, 150, 0.18) 35%,
      rgba(255, 115, 59, 0.07) 60%,
      transparent 75%
    );
    opacity: 0.85;
    animation: floatMorphYellow 22s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  /* 2. Interactive Flame Cursor Glow */
  .ambient-orb--interactive {
    top: 0;
    left: 0;
    width: 42vw;
    height: 42vw;
    max-width: 600px;
    max-height: 600px;
    background: radial-gradient(
      circle,
      rgba(255, 115, 59, 0.22) 0%,
      rgba(240, 171, 150, 0.08) 50%,
      transparent 70%
    );
    opacity: 0.8;
    filter: blur(80px);
    transform: translate3d(50vw, 40vh, 0) translate(-50%, -50%);
    transition: opacity 0.4s ease;
  }

  /* 3. Subtle Atmospheric Emerald Whisper — Adds depth and vitality to dark obsidian */
  .ambient-orb--emerald {
    top: 55vh;
    right: -10vw;
    width: 48vw;
    height: 48vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(0, 200, 101, 0.12) 0%,
      rgba(0, 200, 101, 0.04) 40%,
      transparent 70%
    );
    opacity: 0.65;
    filter: blur(120px);
    animation: floatMorphEmerald 30s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  /* Organic Fluid Morphing & Orbit Keyframes */
  @keyframes floatMorphYellow {
    0% {
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    }
    33% {
      transform: translate3d(6vw, 8vh, 0) scale(1.08) rotate(45deg);
      border-radius: 40% 60% 60% 40% / 40% 60% 30% 70%;
    }
    66% {
      transform: translate3d(-5vw, 14vh, 0) scale(0.94) rotate(90deg);
      border-radius: 50% 50% 30% 70% / 70% 40% 60% 40%;
    }
    100% {
      transform: translate3d(8vw, 4vh, 0) scale(1.05) rotate(135deg);
      border-radius: 60% 40% 50% 50% / 50% 50% 60% 40%;
    }
  }

  @keyframes floatMorphEmerald {
    0% {
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
      border-radius: 50% 50% 40% 60% / 60% 40% 60% 40%;
    }
    50% {
      transform: translate3d(-6vw, -8vh, 0) scale(1.1) rotate(-60deg);
      border-radius: 40% 60% 60% 40% / 50% 50% 40% 60%;
    }
    100% {
      transform: translate3d(4vw, 6vh, 0) scale(0.95) rotate(45deg);
      border-radius: 60% 40% 50% 50% / 40% 60% 50% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-orb {
      animation: none !important;
    }
    .ambient-orb--interactive {
      display: none !important;
    }
  }
</style>

<script>
  // Silky Smooth Interactive Mouse Follower
  const interactiveOrb = document.getElementById('ambient-interactive-orb');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (interactiveOrb && !prefersReduced && window.innerWidth > 768) {
    let mouseX = window.innerWidth * 0.5;
    let mouseY = window.innerHeight * 0.4;
    let currentX = mouseX;
    let currentY = mouseY;
    let isVisible = true;
    let rafId: number;

    const onMouseMove = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!isVisible) {
        isVisible = true;
        interactiveOrb.style.opacity = '0.8';
      }
    };

    const onMouseLeave = () => {
      isVisible = false;
      interactiveOrb.style.opacity = '0';
    };

    const update = () => {
      currentX += (mouseX - currentX) * 0.055;
      currentY += (mouseY - currentY) * 0.055;
      interactiveOrb.style.transform = `translate3d(${currentX.toFixed(1)}px, ${currentY.toFixed(1)}px, 0) translate(-50%, -50%)`;
      rafId = requestAnimationFrame(update);
    };

    window.addEventListener('mousemove', onMouseMove, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave, { passive: true });
    update();
  }
</script>