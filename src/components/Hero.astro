---
// src/components/Hero.astro
---

<!-- Section 2: Hero Section -->
<section class="hero" id="hero" aria-label="Hero">
  <div class="hero__content">
    <div class="hero__statement">
      <h1 class="reveal">
        We engineer video that commands the feed,and the digital flagships to match.
      </h1>
    </div>

    <p class="hero__sub reveal reveal-delay-2">
      Renvel is a <strong>premium video content studio</strong>. We shoot, edit, and grow short-form content that turns attention into demand — and for brands that go all-in with us, we build <strong>the web experience to match</strong>.
    </p>

    <!-- Rounded Rectangle CTA Button placed in the middle above the dropdown line -->
    <div class="hero__badge-wrap reveal reveal-delay-3">
      <a href="#contact" class="hero__cta-btn" id="hero-cta" aria-label="Start a project - Contact Us">
        <span class="hero__cta-text">Start a Project</span>
        <span class="hero__cta-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </span>
      </a>
    </div>
  </div>

  <!-- Hero Scroll Line -->
  <div class="hero__scroll-container" aria-hidden="true">
    <div class="hero__scroll-line"></div>
  </div>
</section>