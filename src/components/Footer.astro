---
// src/components/Footer.astro
---

<!-- Section 10: Footer / Direct Action Trigger -->
<footer class="footer section-border" id="contact" role="contentinfo" aria-label="Contact and footer" itemscope itemtype="https://schema.org/Organization">
  <meta itemprop="name" content="Renvel Studio" />
  <meta itemprop="url" content="https://renvel.studio" />
  <meta itemprop="logo" content="https://renvel.studio/Assets/renvel-assets/renvel-logo.png" />

  <div class="footer__main">
    <div class="footer__headline-container reveal">
      <h2>Your next project?<br />Could be your <span class="text-gradient">best.</span></h2>
    </div>

    <div class="footer__cta-section reveal reveal-delay-1">
      <a href="mailto:hello@renvel.studio" class="footer__cta-link magnetic-btn" id="footer-cta">
        <span class="footer__cta-text">Start a Conversation</span>
        <span class="footer__cta-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__clock" id="footer-clock" aria-label="Live timezone clock">
      Athens, Greece 00:00:00
    </div>

    <div class="footer__social">
      <a href="https://www.instagram.com/renvel.creative" class="footer__social-link" id="link-instagram" target="_blank" rel="noopener noreferrer" aria-label="Instagram" itemprop="sameAs">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer__social-icon" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
      <a href="https://tiktok.com/@renvel.creative" class="footer__social-link" id="link-tiktok" target="_blank" rel="noopener noreferrer" aria-label="TikTok" itemprop="sameAs">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" class="footer__social-icon">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.33 22a6.33 6.33 0 0 0 6.34-6.32V8.65a8.28 8.28 0 0 0 4.83 1.55V6.75a4.86 4.86 0 0 1-.91-.06z"></path>
        </svg>
      </a>
    </div>

    <p class="footer__copyright">
      &copy; <span id="copyright-year">2026</span> Renvel Studio. All rights reserved.
    </p>
  </div>
</footer>