---
// src/components/Focus.astro
---

<!-- Section 7: Our Focus (Premium GSAP Pinned Horizontal Showcase) -->
<section class="focus-pinned-section" id="focus" aria-label="Our Focus">
  <h2 class="sr-only">Our Focus</h2>

  <div class="focus-sticky-viewport" id="focus-sticky-viewport">

    <!-- Atmospheric Ambient Glow Behind Title (Disabled cleanly via CSS) -->
    <div class="focus-ambient-glow" id="focus-ambient-glow" aria-hidden="true"></div>

    <!-- Majestic Cinematic Backdrop Title ("our focus") -->
    <div class="focus-blur-title" id="focus-blur-title" aria-hidden="true">
      <span class="focus-blur-title__line" id="focus-line-our">
        <span class="focus-char">o</span><span class="focus-char">u</span><span class="focus-char">r</span>
      </span>
      <span class="focus-blur-title__line" id="focus-line-focus">
        <span class="focus-char">f</span><span class="focus-char">o</span><span class="focus-char">c</span><span class="focus-char">u</span><span class="focus-char">s</span>
      </span>
    </div>

    <!-- Free-floating Clean Numeric Counter -->
    <div class="focus-counter" id="focus-counter" aria-label="Discipline counter">
      <span class="focus-counter__current" id="focus-counter-current">01</span>
      <span class="focus-counter__slash">/</span>
      <span class="focus-counter__total">03</span>
    </div>

    <!-- Horizontal Moving Tiles Track -->
    <div class="focus-horizontal-strip" id="focus-horizontal-strip">

      <!-- Tile 1: Cinema-Grade Short-Form -->
      <article
        class="focus-tile is-active"
        id="focus-tile-1"
        data-tile-index="0"
        itemscope
        itemtype="https://schema.org/Service"
      >
        <div class="focus-tile__content">
          <span class="focus-tile__kicker">Production &amp; Optics</span>
          <h3 class="focus-tile__heading" itemprop="name">Cinema-Grade Short-Form</h3>
          <p class="focus-tile__desc" itemprop="description">
            We produce high-retention short-form video for TikTok, Reels, and Shorts. Cinema optics, intentional lighting, and dynamic editing calibrated to stop the scroll and build an obsessed audience.
          </p>
        </div>
        <div class="focus-tile__visual" aria-hidden="true">
          <div class="focus-badge">
            <div class="focus-badge__glow"></div>
            <div class="focus-badge__ring focus-badge__ring--outer"></div>
            <div class="focus-badge__ring focus-badge__ring--inner"></div>
            <span class="focus-badge__crosshair focus-badge__crosshair--tl">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--tr">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--bl">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--br">+</span>
            <div class="focus-badge__core">
              <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clapperboard" aria-hidden="true">
                <path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z"></path>
                <path d="m6.2 5.3 3.1 3.9"></path>
                <path d="m12.4 3.4 3.1 4"></path>
                <path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path>
              </svg>
            </div>
          </div>
        </div>
      </article>

      <!-- Tile 2: Algorithmic Content Strategy -->
      <article
        class="focus-tile"
        id="focus-tile-2"
        data-tile-index="1"
        itemscope
        itemtype="https://schema.org/Service"
      >
        <div class="focus-tile__content">
          <span class="focus-tile__kicker">Audience Intelligence</span>
          <h3 class="focus-tile__heading" itemprop="name">Algorithmic Content Strategy</h3>
          <p class="focus-tile__desc" itemprop="description">
            We analyze audience psychology and feed algorithms before shooting a single frame. Data-backed hooks and organic distribution frameworks engineered to turn attention into authority.
          </p>
        </div>
        <div class="focus-tile__visual" aria-hidden="true">
          <div class="focus-badge">
            <div class="focus-badge__glow"></div>
            <div class="focus-badge__ring focus-badge__ring--outer"></div>
            <div class="focus-badge__ring focus-badge__ring--inner"></div>
            <span class="focus-badge__crosshair focus-badge__crosshair--tl">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--tr">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--bl">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--br">+</span>
            <div class="focus-badge__core">
              <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain-circuit" aria-hidden="true">
                <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path>
                <path d="M9 13a4.5 4.5 0 0 0 3-4"></path>
                <path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path>
                <path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path>
                <path d="M6 18a4 4 0 0 1-1.967-.516"></path>
                <path d="M12 13h4"></path>
                <path d="M12 18h6a2 2 0 0 1 2 2v1"></path>
                <path d="M12 8h8"></path>
                <path d="M16 8V5a2 2 0 0 1 2-2"></path>
                <circle cx="16" cy="13" r=".5"></circle>
                <circle cx="18" cy="3" r=".5"></circle>
                <circle cx="20" cy="21" r=".5"></circle>
                <circle cx="20" cy="8" r=".5"></circle>
              </svg>
            </div>
          </div>
        </div>
      </article>

      <!-- Tile 3: Immersive Web Flagships -->
      <article
        class="focus-tile"
        id="focus-tile-3"
        data-tile-index="2"
        itemscope
        itemtype="https://schema.org/Service"
      >
        <div class="focus-tile__content">
          <span class="focus-tile__kicker">Full-Pipeline Conversion</span>
          <h3 class="focus-tile__heading" itemprop="name">Immersive Web Flagships</h3>
          <p class="focus-tile__desc" itemprop="description">
            Attention without infrastructure is wasted. We complete the creative pipeline by channeling viral traffic into bespoke digital flagships, converting captured viewers into clients.
          </p>
        </div>
        <div class="focus-tile__visual" aria-hidden="true">
          <div class="focus-badge">
            <div class="focus-badge__glow"></div>
            <div class="focus-badge__ring focus-badge__ring--outer"></div>
            <div class="focus-badge__ring focus-badge__ring--inner"></div>
            <span class="focus-badge__crosshair focus-badge__crosshair--tl">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--tr">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--bl">+</span>
            <span class="focus-badge__crosshair focus-badge__crosshair--br">+</span>
            <div class="focus-badge__core">
              <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
            </div>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>