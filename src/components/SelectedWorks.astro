---
// src/components/SelectedWorks.astro

interface Project {
  id: string;
  name: string;
  industry: string;
  deliverables: string;
  year: string;
  video: string;
  poster: string;
  alt: string;
  metricValue: string;
  metricLabel: string;
  url: string;
}

const projects: Project[] = [
  {
    id: 'project-kinetic',
    name: 'KOUVARIS | CUSTOMS CLEARANCE',
    industry: 'Customs Brokerage & Clearance Services: Vehicles & Commercial Cargo',
    deliverables: 'HIGH-INTENT INBOUND LEAD GENERATION · EARNED MEDIA VALUE & ORGANIC CONVERSIONS · Creative Direction',
    year: '2026',
    video: '/videos/1.mp4',
    poster: '/videos/posters/1-poster.webp',
    alt: 'Kouvaris Customs Clearance Campaign — High-engagement vehicle customs brokerage and commercial cargo clearance reel showcase',
    metricValue: '7M+ CROSS PLATFORM VIEWS',
    metricLabel: '100% ORGANIC ACQUISITION & ZERO AD SPEND',
    url: 'https://www.tiktok.com/@ektelonismoi_kouvaris'
  },
  {
    id: 'project-aether',
    name: 'FN FASHION',
    industry: 'B2B APPAREL WHOLESALE & BULK SUPPLY',
    deliverables: 'RETAILER ACQUISITION · SOCIAL LEAD ENGINE · DM PIPELINE',
    year: '2026',
    video: '/videos/2.mp4',
    poster: '/videos/posters/2-poster.webp',
    alt: 'FN Fashion B2B Apparel Wholesale Campaign — Social lead engine showcasing boutique fashion collections and bulk garment supply',
    metricValue: '+420% Organic Search Traffic Growth',
    metricLabel: '',
    url: 'https://www.tiktok.com/@fnfashion_official'
  },
  {
    id: 'project-lumen',
    name: 'KOUNOUVELIS_WOOD',
    industry: 'PREMIUM WOOD SUPPLIES, SOLID SURFACES & CUSTOM CABINETRY',
    deliverables: 'B2B MATERIAL SUPPLY & WHOLESALE CONTRACTS',
    year: '2026',
    video: '/videos/3.mp4',
    poster: '/videos/posters/3-poster.webp',
    alt: 'Kounouvelis Wood B2B Material Supply Campaign — Premium lumber supplies, solid surfaces, and custom cabinetry showcase',
    metricValue: '+315% TRADE INQUIRIES',
    metricLabel: ' ',
    url: 'https://www.tiktok.com/@kounouvelis_wood'
  },
  {
    id: 'project-valo',
    name: 'MICHAILIDIS FYLLO_VERGAS',
    industry: 'TRADITIONAL DOUGH PASTRY',
    deliverables: 'CULINARY SHOWCASES · HORECA LEAD ENGINE · ARTISAN DOUGH CRAFT',
    year: '2026',
    video: '/videos/4.mp4',
    poster: '/videos/posters/4-poster.webp',
    alt: 'Michailidis Fyllo Vergas Artisan Pastry Campaign — Traditional culinary dough craft showcase and HORECA lead engine reel',
    metricValue: '+140% B2B INQUIRIES',
    metricLabel: '',
    url: 'https://www.tiktok.com/@michailidis.fyllo'
  }
];
---

<!-- Section 5: Selected Works Grid -->
<section class="works section-border" id="work" aria-label="Selected work">
  <div class="works__header reveal">
    <div>
      <span class="works__label">Selected Work</span>
      <h2 class="t-heading-1" style="margin-top: 1rem;">
        Growth systems<br />that <span class="text-gradient-alt">scaled revenue.</span>
      </h2>
    </div>
    <span class="works__label">04 Cases</span>
  </div>

  <div class="works__grid">
    {projects.map((project) => (
      <a
        class="works__item reveal"
        id={project.id}
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View ${project.name} case study on TikTok`}
      >
        <div class="works__item-media">
          <video
            class="works__item-video"
            poster={project.poster}
            preload="metadata"
            muted
            loop
            playsinline
            aria-label={project.alt}
          >
            <source src={project.video} type="video/mp4" />
          </video>
          <div class="works__item-overlay"></div>
        </div>

        <div class="works__item-meta">
          <div class="works__glass-badge">
            <span class="luminous-dot"></span>
            <span class="works__glass-badge-text">Case Study</span>
            <span class="works__glass-arrow">↗</span>
          </div>

          <h3 class="works__item-name">{project.name}</h3>
          <span class="works__item-industry">{project.industry}</span>

          <div class="works__metric-block">
            <span class="works__metric-value">{project.metricValue}</span>
            {project.metricLabel && project.metricLabel.trim() && (
              <span class="works__metric-label">{project.metricLabel}</span>
            )}
          </div>

          <div class="works__item-footer">
            <span class="works__item-deliverables">{project.deliverables}</span>
            <span class="works__item-year">{project.year}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

