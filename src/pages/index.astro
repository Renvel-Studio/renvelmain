---
import '../styles/global.css';
import BackgroundCanvas from '../components/BackgroundCanvas.astro';
import Cursor from '../components/Cursor.astro';
import Navbar from '../components/Navbar.astro';
import SiteMenu from '../components/SiteMenu.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Banner from '../components/Banner.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import Process from '../components/Process.astro';
import Focus from '../components/Focus.astro';
import Newsletter from '../components/Newsletter.astro';
import Manifesto from '../components/Manifesto.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Renvel Studio — Social Media, SEO & Web Growth Agency</title>
  <meta
    name="description"
    content="Renvel Studio is a high-end digital growth agency inspired by German editorial design, specializing in social media marketing, SEO, and high-converting websites."
  />
  <meta name="author" content="Renvel Studio" />
  <meta name="theme-color" content="#090c13" />
  <link rel="canonical" href="https://renvel.studio/" />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  <!-- Open Graph -->
  <meta property="og:title" content="Renvel Studio — Social Media, SEO & Web Growth" />
  <meta
    property="og:description"
    content="Specialized digital growth agency fusing high-converting website architecture, dominant SEO strategy, and high-impact social media campaigns."
  />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content="https://renvel.studio/" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Renvel Studio — Social Media, SEO & Web Growth" />
  <meta
    name="twitter:description"
    content="Specialized digital growth agency fusing high-converting website architecture, dominant SEO strategy, and high-impact social media campaigns."
  />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/Assets/renvel-assets/renvel-favicon.png" />

  <!-- Fonts: Fraunces (Full Variable Range w/ opsz & wght) · Switzer · Fragment Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Fragment+Mono:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@100,200,300,400,500,600,700&display=swap" rel="stylesheet" />
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <!-- Ambient visual layers -->
  <BackgroundCanvas />
  <Cursor />

  <!-- Navigation & Overlays -->
  <Navbar />
  <SiteMenu />

  <!-- Main Content Flow -->
  <main id="main-content">
    <Hero />
    <Intro />
    <Banner />
    <SelectedWorks />
    <Process />
    <Focus />
    <Newsletter />
    <Manifesto />
  </main>

  <!-- Global Footer -->
  <Footer />

  <!-- Client-side Animation & Interaction Bundle -->
  <script src="../scripts/main.ts"></script>
</body>
</html>